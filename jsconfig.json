// SPEC-025 AC 9: `npm run typecheck` (scripts/typecheck.js) — tsc --noEmit --checkJs over the game code; TypeScript is a dev
// dependency only, nothing is built or changed at runtime. This file: the whole of src/ at the basic level (the client);
// jsconfig.core.json: the core strict-ish, without the DOM. types/globals.d.ts: the page's globals; types/three.d.ts: "three" (any: the vendored
// three.js ships no types).
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true,
    "paths": { "three": ["./types/three.d.ts"] }
  },
  "include": ["src/**/*.js", "types/globals.d.ts", "types/three.d.ts"]
}
